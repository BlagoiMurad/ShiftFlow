@model LoginViewModel
@{ ViewData["Title"] = "Вход"; }
<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card p-4">
            <h2 class="mb-1">Вход в системата</h2>
            <p class="text-muted">Планиране на смени и отчитане на работното време</p>
            <form asp-action="Login" method="post">
                <partial name="_FormErrors" />
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-primary w-100">Вход</button>
            </form>
        </div>
        <div class="card p-3 mt-3 small text-muted">
            <strong>Демо акаунти:</strong>
            admin@shiftflow.bg / Admin123 ·
            manager@shiftflow.bg / Manager123 ·
            ivan@shiftflow.bg / Employee123
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
