@model MyTimeViewModel
@{ ViewData["Title"] = "Работно време"; }
<h2>Работно време</h2>
<div class="row g-3 mb-4">
    <div class="col-md-5">
        <div class="card p-4 text-center">
            <div class="clock-big" id="clock">@DateTime.Now.ToString("HH:mm")</div>
            @if (Model.CurrentShift != null)
            {
                <div class="text-muted mb-3">Смяна: @Model.CurrentShift.Start.ToString("HH:mm") – @Model.CurrentShift.End.ToString("HH:mm"), @Model.CurrentShift.Department.Name</div>
            }
            else
            {
                <div class="text-muted mb-3">Нямате смяна в момента</div>
            }
            @if (Model.OpenEntry != null)
            {
                <p>На работа от <strong>@Model.OpenEntry.ClockIn.ToString("HH:mm")</strong></p>
                <form asp-action="ClockOut" method="post">
                    <input name="note" class="form-control mb-2" placeholder="Бележка (по желание)" />
                    <button class="btn btn-danger btn-lg w-100">Отбележи изход</button>
                </form>
            }
            else
            {
                <form asp-action="ClockIn" method="post">
                    <button class="btn btn-success btn-lg w-100">Отбележи вход</button>
                </form>
            }
        </div>
    </div>
    <div class="col-md-7">
        <form method="get" class="row g-2 align-items-end mb-2">
            <div class="col"><label class="form-label small">От</label><input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" /></div>
            <div class="col"><label class="form-label small">До</label><input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" /></div>
            <div class="col-auto"><button class="btn btn-outline-primary">Покажи</button></div>
        </form>
        <div class="card">
            <table class="table mb-0">
                <thead><tr><th>Дата</th><th>Вход</th><th>Изход</th><th>Часове</th><th></th></tr></thead>
                <tbody>
                    @foreach (var e in Model.Entries)
                    {
                        var late = e.Shift != null && e.ClockIn > e.Shift.Start.AddMinutes(5);
                        <tr>
                            <td>@e.ClockIn.ToString("dd.MM.yyyy")</td>
                            <td class="@(late ? "text-danger" : "")">@e.ClockIn.ToString("HH:mm") @if (late) { <span class="small">(закъснение)</span> }</td>
                            <td>@(e.ClockOut?.ToString("HH:mm") ?? "—")</td>
                            <td>@DisplayHelpers.Hours(e.WorkedHours)</td>
                            <td>@if (e.IsManualCorrection) { <span class="badge bg-info text-dark" title="@e.Note">коригиран</span> }</td>
                        </tr>
                    }
                    @if (!Model.Entries.Any()) { <tr><td colspan="5" class="text-muted">Няма записи за периода.</td></tr> }
                </tbody>
                <tfoot><tr><th colspan="3">Общо</th><th colspan="2">@DisplayHelpers.Hours(Model.TotalHours)</th></tr></tfoot>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        setInterval(() => {
            const d = new Date();
            document.getElementById('clock').textContent =
                d.getHours().toString().padStart(2, '0') + ':' + d.getMinutes().toString().padStart(2, '0');
        }, 10000);
    </script>
}
