@model ShiftFormViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Нова смяна" : "Редакция на смяна"; }
<h2>@ViewData["Title"]</h2>
<div class="card p-4 form-card">
    <form asp-action="Save" method="post">
        <partial name="_FormErrors" />
        <input type="hidden" asp-for="Id" />
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="EmployeeId" class="form-label"></label><select asp-for="EmployeeId" asp-items="Model.Employees" class="form-select"><option value="">— изберете —</option></select><span asp-validation-for="EmployeeId" class="text-danger small"></span></div>
            <div class="col-md-6 mb-3"><label asp-for="DepartmentId" class="form-label"></label><select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select"><option value="">— изберете —</option></select><span asp-validation-for="DepartmentId" class="text-danger small"></span></div>
            <div class="col-md-4 mb-3"><label asp-for="Date" class="form-label"></label><input asp-for="Date" class="form-control" /></div>
            <div class="col-md-4 mb-3"><label asp-for="StartTime" class="form-label"></label><input asp-for="StartTime" class="form-control" /></div>
            <div class="col-md-4 mb-3"><label asp-for="EndTime" class="form-label"></label><input asp-for="EndTime" class="form-control" /><div class="form-text">Ако е преди началото, смяната свършва на следващия ден.</div></div>
            <div class="col-md-4 mb-3"><label asp-for="BreakMinutes" class="form-label"></label><input asp-for="BreakMinutes" class="form-control" /><span asp-validation-for="BreakMinutes" class="text-danger small"></span></div>
            @if (Model.Id != 0)
            {
                <div class="col-md-4 mb-3"><label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        @foreach (ShiftStatus st in Enum.GetValues<ShiftStatus>()) { <option value="@st">@st.ToBg()</option> }
                    </select>
                </div>
            }
            <div class="col-12 mb-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
        </div>
        <div class="mb-3">
            <span class="text-muted small">Бързо:</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setTimes('07:00','15:00')">Сутрешна 07–15</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setTimes('15:00','23:00')">Следобедна 15–23</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setTimes('23:00','07:00')">Нощна 23–07</button>
        </div>
        <button class="btn btn-primary">Запази</button>
        <a asp-action="Index" asp-route-week="@Model.Date.ToString("yyyy-MM-dd")" class="btn btn-link">Назад</a>
    </form>
    @if (Model.Id != 0)
    {
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3" onsubmit="return confirm('Изтриване на смяната?');">
            <button class="btn btn-outline-danger btn-sm">Изтрий смяната</button>
        </form>
    }
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setTimes(a, b) {
            document.getElementById('StartTime').value = a;
            document.getElementById('EndTime').value = b;
        }
    </script>
}
