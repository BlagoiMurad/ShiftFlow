@model EmployeeDetailsViewModel
@{ var e = Model.Employee; ViewData["Title"] = e.FirstName + " " + e.LastName; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@e.FirstName @e.LastName @if (!Model.IsActive) { <span class="badge bg-secondary">Неактивен</span> }</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-outline-secondary">Редактирай</a>
        <a asp-controller="Shifts" asp-action="Create" asp-route-employeeId="@e.Id" class="btn btn-outline-primary">+ Смяна</a>
        <form asp-action="ToggleActive" asp-route-id="@e.Id" method="post" class="d-inline">
            <button class="btn @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(Model.IsActive ? "Деактивирай" : "Активирай")</button>
        </form>
    </div>
</div>
<div class="row g-3">
    <div class="col-md-4">
        <div class="card p-3">
            <dl class="mb-0">
                <dt>Имейл</dt><dd>@e.Email</dd>
                <dt>Телефон</dt><dd>@(e.PhoneNumber ?? "—")</dd>
                <dt>Отдел</dt><dd>@(Model.DepartmentName ?? "—")</dd>
                <dt>Длъжност</dt><dd>@(Model.PositionName ?? "—")</dd>
                <dt>Роля</dt><dd>@DisplayHelpers.RoleToBg(e.Role)</dd>
                <dt>Назначен на</dt><dd>@e.HireDate.ToString("dd.MM.yyyy")</dd>
                <dt>Часове по договор</dt><dd>@e.WeeklyHours ч./седмица</dd>
                <dt>Оставащ платен отпуск</dt><dd>@Model.PaidLeaveDaysLeft дни</dd>
            </dl>
        </div>
    </div>
    <div class="col-md-8">
        <h5>Предстоящи смени</h5>
        <div class="card mb-3">
            <table class="table mb-0">
                <tbody>
                    @foreach (var s in Model.UpcomingShifts)
                    {
                        <tr>
                            <td>@DisplayHelpers.DayName(s.Start), @s.Start.ToString("dd.MM")</td>
                            <td>@s.Start.ToString("HH:mm") – @s.End.ToString("HH:mm")</td>
                            <td>@s.Department.Name</td>
                            <td><span class="badge @s.Status.BadgeClass()">@s.Status.ToBg()</span></td>
                        </tr>
                    }
                    @if (!Model.UpcomingShifts.Any()) { <tr><td class="text-muted">Няма предстоящи смени.</td></tr> }
                </tbody>
            </table>
        </div>
        <h5>Отпуски</h5>
        <div class="card">
            <table class="table mb-0">
                <tbody>
                    @foreach (var l in Model.Leaves)
                    {
                        <tr>
                            <td>@l.Type.ToBg()</td>
                            <td>@l.StartDate.ToString("dd.MM.yyyy") – @l.EndDate.ToString("dd.MM.yyyy") (@l.Days дни)</td>
                            <td><span class="badge @l.Status.BadgeClass()">@l.Status.ToBg()</span></td>
                        </tr>
                    }
                    @if (!Model.Leaves.Any()) { <tr><td class="text-muted">Няма заявки за отпуск.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
