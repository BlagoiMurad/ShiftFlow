@model ReportViewModel
@{ ViewData["Title"] = "Справка за работното време"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Справка за работното време</h2>
    <a asp-action="ExportCsv" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-departmentId="@Model.DepartmentId" class="btn btn-outline-success">Експорт в Excel (CSV)</a>
</div>
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-3"><label asp-for="From" class="form-label small"></label><input asp-for="From" name="from" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="To" class="form-label small"></label><input asp-for="To" name="to" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="DepartmentId" class="form-label small"></label><select name="departmentId" asp-items="Model.Departments" class="form-select"><option value="">Всички</option></select></div>
    <div class="col-md-3"><button class="btn btn-primary w-100">Покажи</button></div>
</form>
<div class="card">
    <div class="table-responsive">
    <table class="table mb-0 align-middle">
        <thead><tr><th>Служител</th><th>Отдел</th><th>Смени</th><th>Планирани</th><th>Отработени</th><th>Разлика</th><th>Закъснения</th><th>Дни отпуск</th><th>Заплащане</th></tr></thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td><a asp-controller="TimeEntries" asp-action="Manage" asp-route-employeeId="@r.EmployeeId" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">@r.EmployeeName</a></td>
                    <td>@r.DepartmentName</td>
                    <td>@r.ShiftCount</td>
                    <td>@DisplayHelpers.Hours(r.PlannedHours)</td>
                    <td>@DisplayHelpers.Hours(r.WorkedHours)</td>
                    <td class="@(r.Difference < -1 ? "text-danger" : r.Difference > 1 ? "text-success" : "")">@(r.Difference > 0 ? "+" : "")@r.Difference.ToString("0.##")</td>
                    <td class="@(r.LateArrivals > 0 ? "text-danger" : "")">@r.LateArrivals</td>
                    <td>@r.LeaveDays</td>
                    <td>@r.EstimatedPay.ToString("0.00") лв.</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">Общо</th>
                <th>@DisplayHelpers.Hours(Model.Rows.Sum(r => r.PlannedHours))</th>
                <th>@DisplayHelpers.Hours(Model.Rows.Sum(r => r.WorkedHours))</th>
                <th></th>
                <th>@Model.Rows.Sum(r => r.LateArrivals)</th>
                <th>@Model.Rows.Sum(r => r.LeaveDays)</th>
                <th>@Model.Rows.Sum(r => r.EstimatedPay).ToString("0.00") лв.</th>
            </tr>
        </tfoot>
    </table>
    </div>
</div>
<p class="small text-muted mt-2">Броят се само смени, които вече са приключили. Закъснение: вход повече от 5 минути след началото на смяната. Заплащането е по часовата ставка на длъжността.</p>
