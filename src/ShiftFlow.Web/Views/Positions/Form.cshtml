@model PositionFormViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Нова длъжност" : "Редакция на длъжност"; }
<h2>@ViewData["Title"]</h2>
<div class="card p-4 form-card">
    <form asp-action="Save" method="post">
        <partial name="_FormErrors" />
        <input type="hidden" asp-for="Id" />
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="HourlyRate" class="form-label"></label><input asp-for="HourlyRate" class="form-control" step="0.01" /><span asp-validation-for="HourlyRate" class="text-danger small"></span></div>
        <button class="btn btn-primary">Запази</button>
        <a asp-action="Index" class="btn btn-link">Назад</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
